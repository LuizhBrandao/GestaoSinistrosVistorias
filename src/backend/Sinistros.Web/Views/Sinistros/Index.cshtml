@using Sinistros.Domain.Enums
@model IReadOnlyList<Sinistros.Application.DTOs.SinistroResumoDto>

@{
    ViewData["Title"] = "Fila de Regulação de Sinistros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Sinistros & Esteira de Regulação</h2>
        <p class="text-muted mb-0">Listagem de processos sinistrais com status e alçadas pendentes de decisão.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Número do Sinistro</th>
                        <th>Veículo / Placa</th>
                        <th>Apólice</th>
                        <th>Valor FIPE</th>
                        <th>Franquia</th>
                        <th>Status Atual</th>
                        <th>Data de Ocorrência</th>
                        <th class="text-end pe-4">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Nenhum sinistro pendente encontrado.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">
                                <span class="font-monospace text-primary">@item.NumeroSinistro</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary font-monospace">@item.PlacaVeiculo</span>
                            </td>
                            <td>
                                <span class="small font-monospace">@item.NumeroApolice</span>
                            </td>
                            <td class="fw-semibold">
                                R$ @item.ValorFipeReferencia.ToString("N2")
                            </td>
                            <td>
                                R$ @item.Franquia.ToString("N2")
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case StatusSinistro.Aberto:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Aberto</span>
                                        break;
                                    case StatusSinistro.AguardandoVistoria:
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Aguardando Vistoria</span>
                                        break;
                                    case StatusSinistro.AguardandoAprovacaoAlcada:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Alçada Pendente</span>
                                        break;
                                    case StatusSinistro.Aprovado:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Aprovado</span>
                                        break;
                                    case StatusSinistro.Liquidado:
                                        <span class="badge bg-dark-subtle text-dark border border-dark-subtle">Liquidado</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small">
                                @item.DataOcorrenciaUtc.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Detalhes & Regulação
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
