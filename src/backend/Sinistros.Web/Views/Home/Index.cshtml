@{
    ViewData["Title"] = "Dashboard Corporativo";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="p-4 bg-white rounded-3 shadow-sm border d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1">Central de Regulação de Sinistros e Vistorias</h2>
                <p class="text-muted mb-0">Módulo central de auditoria, conformidade SUSEP e motor de decisão de alçadas em .NET 10.</p>
            </div>
            <a asp-controller="Sinistros" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-inbox-fill me-2"></i> Ver Fila de Regulação
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold small mb-1">Aguardando Vistoria</h6>
                        <h3 class="fw-bold mb-0 text-primary">1</h3>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="bi bi-camera-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    <span class="text-primary fw-bold">SPA Angular</span> pronto para vistoria
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold small mb-1">Alçada Requerida</h6>
                        <h3 class="fw-bold mb-0 text-warning">2</h3>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    Supervisor / Gerente necessário
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold small mb-1">Perda Total Detectada</h6>
                        <h3 class="fw-bold mb-0 text-danger">1</h3>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                        <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    Reparo &ge; 75% da Tabela FIPE
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-semibold small mb-1">Integridade / Auditoria</h6>
                        <h3 class="fw-bold mb-0 text-success">100%</h3>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="bi bi-fingerprint fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 small text-muted">
                    Trilha imutável registrada
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">Fluxo Arquitetural End-to-End</h5>
            </div>
            <div class="card-body p-4">
                <div class="timeline">
                    <div class="d-flex mb-3">
                        <div class="me-3 text-primary"><i class="bi bi-1-circle-fill fs-3"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Abertura de Sinistro (.NET Core API)</h6>
                            <p class="text-muted small mb-0">Validação da apólice, veículo e franquia. Emissão do evento <code>sinistro.evento.criado</code> via RabbitMQ.</p>
                        </div>
                    </div>
                    <div class="d-flex mb-3">
                        <div class="me-3 text-primary"><i class="bi bi-2-circle-fill fs-3"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Vistoria Técnica & Upload Assíncrono (Angular + Node.js)</h6>
                            <p class="text-muted small mb-0">Perito registra checklist de peças e fotos. O microsserviço Node.js comprime imagens em WebP e valida metadados EXIF anti-fraude.</p>
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="me-3 text-primary"><i class="bi bi-3-circle-fill fs-3"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1">Motor de Regulação & Esteira de Alçadas (.NET 10 MVC)</h6>
                            <p class="text-muted small mb-0">Classificação de Perda Parcial vs. Total (75% FIPE), cálculo do valor líquido e autorização de alçadas com trilha de auditoria.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">Recursos do Ambiente</h5>
            </div>
            <div class="card-body p-3">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-database me-2 text-primary"></i> PostgreSQL 16</span>
                        <span class="badge bg-success-subtle text-success">Ativo (Multi-Schema)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-broadcast me-2 text-warning"></i> RabbitMQ AMQP</span>
                        <a href="http://localhost:15672" target="_blank" class="badge bg-warning-subtle text-warning text-decoration-none">Porta 15672</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-braces me-2 text-info"></i> .NET 10 Core</span>
                        <span class="badge bg-info-subtle text-info">Clean Architecture</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
